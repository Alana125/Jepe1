{
  "name": "jepe-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API do Sistema JEPE",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "db:migrate": "node-pg-migrate up --envPath .env",
    "db:rollback": "node-pg-migrate down --envPath .env"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "node-pg-migrate": "^7.9.1",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "glob": "^11.1.0"
  }
}
